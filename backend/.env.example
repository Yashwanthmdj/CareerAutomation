APP_NAME=Nexus Auth API
APP_ENV=development

DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/nexus

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60

FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173

# Supabase Storage (private bucket: resumes)
# Backend reads SUPABASE_URL; NEXT_PUBLIC_SUPABASE_URL is accepted as a fallback.
SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_BUCKET_NAME=resumes
